{
  "name": "kp-hotel-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Hotel KP & Restaurant — NestJS REST API (bookings, GST billing, payments)",
  "scripts": {
    "start:dev": "nest start --watch",
    "start": "nest start",
    "build": "nest build",
    "build:lambda": "nest build && node scripts/build-lambda.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "create-owner": "nest build && node dist/cli/create-owner.js",
    "docs:api": "nest build && node dist/cli/generate-api-docs.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/client-sesv2": "^3.1156.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.7",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^6.19.0",
    "@vendia/serverless-express": "^4.12.6",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.4.0",
    "dotenv": "^16.4.7",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^10.2.1",
    "pdf-lib": "^1.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.8",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.20",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "chokidar": "^5.0.0",
    "esbuild": "^0.28.2",
    "prisma": "^6.19.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
