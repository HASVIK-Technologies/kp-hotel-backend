
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "{src/generated/prisma/**,node_modules/swagger-ui-dist/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?__vercel_path=/api/:path*"
    },
    {
      "source": "/swagger",
      "destination": "/api?__vercel_path=/swagger"
    },
    {
      "source": "/swagger/:path*",
      "destination": "/api?__vercel_path=/swagger/:path*"
    },
    {
      "source": "/swagger-json",
      "destination": "/api?__vercel_path=/swagger-json"
    }
  ]
}
