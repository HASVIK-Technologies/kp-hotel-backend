# ───── Runtime ─────
STAGE=local                       # local | dev | prod
PORT=4000
WEB_ORIGIN=http://localhost:3000  # the frontend (CORS + links in emails)
API_ORIGIN=http://localhost:4000  # public origin of this API (used in links/webhooks)
COOKIE_DOMAIN=
JWT_SECRET=change-me-to-a-long-random-string

# ───── Database / storage ─────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kphotel?schema=public
STORAGE_MODE=fs                   # fs | s3
INVOICE_BUCKET=
DATA_DIR=.data

# ───── Email ─────
MAIL_MODE=file                    # file (writes .data/outbox/*.eml) | console | ses
MAIL_FROM="Hotel KP <no-reply@kphotel.com>"
STAFF_ALERT_EMAIL=kpgrouprasra@gmail.com

# ───── Payments (Cashfree) ─────
CASHFREE_MODE=mock                # mock | sandbox | production  (production refuses mock)
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=

# ───── Seller identity printed on invoices (editable later in Admin → Settings) ─────
HOTEL_GSTIN=09AAAAA0000A1Z0       # placeholder — set the real GSTIN

# ───── Local demo data ─────
SEED_DEMO=1                       # 1 = seed rooms + demo bookings/invoices + demo staff on start
